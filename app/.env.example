# Traceability monitoring DSN (loaded by electron-vite in the main process).
# The public key is a credential — do not commit. See ../.gitignore.
# Copy to `.env` and adjust for your local runtime.
MAIN_VITE_TRACEABILITY_DSN=http://d4f9ed6ebf9a8e08c7af345feccd6198@localhost:3000/1

# Mode-based environment selection (electron-vite loads `.env.<mode>`):
#   pnpm dev / dev:app            -> development mode -> .env.development (local)
#   pnpm dev:test / dev:app:test  -> test mode         -> .env.test (test server)
#   pnpm build / package          -> production mode   -> .env.production
#   pnpm build:test               -> test mode         -> .env.test
#
# Each mode file sets MAIN_VITE_SERVER_URL (main process) and
# VITE_SERVER_URL (renderer). The default fallback in code is
# http://localhost:3000. DSNs for non-development modes can be set in the
# corresponding .env.<mode> file or via CI secrets.
MAIN_VITE_SERVER_URL=http://localhost:3000

{
  "git": {
    "tagName": "@tracerability/cli@${version}",
    "tagAnnotation": "Release @tracerability/cli v${version}",
    "commitMessage": "chore(cli): release v${version}",
    "requireCleanWorkingDir": false,
    "pushArgs": ["--follow-tags"]
  },
  "npm": {
    "publish": true,
    "publishPath": "."
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md",
      "header": "# @tracerability/cli Changelog"
    }
  }
}

# Copy this file to .env.local and fill in your values.
#
# Full DSN issued by the Traceability server. Get one by running:
#   pnpm --filter @tracerability/cli exec traceability project create \
#     --slug demo-web --name "Web Demo" --json
# The `.dsn` field of the response is what goes here.
VITE_TRACEABILITY_DSN=http://REPLACE_ME@127.0.0.1:3300/1

# Release tag stamped on every event. Any string; usually <name>@<commit>.
VITE_RELEASE=web-demo@dev

{
  "name": "@tracerability/server",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/app.ts",
  "exports": {
    "./trpc": {
      "types": "./dist/trpc/app-router.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/integration",
    "dev": "tsx watch src/app.ts",
    "dev:types": "tsc --emitDeclarationOnly --watch --project tsconfig.build.json",
    "dev:dispatcher": "tsx watch src/dispatcher.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:realtime": "tsx watch src/realtime-dispatcher.ts",
    "start": "node dist/app.js",
    "start:dispatcher": "node dist/dispatcher.js",
    "start:worker": "node dist/worker.js",
    "start:realtime": "node dist/realtime-dispatcher.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:setup": "pnpm db:up && sleep 2 && pnpm db:migrate"
  },
  "dependencies": {
    "@ajayche/trpc-panel": "^2.1.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@fastify/busboy": "^3.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@trpc/server": "^11.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "source-map": "^0.8.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "vitest": "catalog:"
  }
}

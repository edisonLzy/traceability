NODE_ENV=development
PORT=3000
HOST=0.0.0.0
POSTGRES_DB=traceability
POSTGRES_USER=traceability
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://traceability:replace-with-a-random-password@127.0.0.1:5432/traceability
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379
PUBLIC_INGEST_URL=http://127.0.0.1:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MINIO_ROOT_USER=traceability
MINIO_ROOT_PASSWORD=replace-with-a-random-password
OBJECT_STORAGE_BUCKET=traceability-sourcemaps
INGEST_MAX_COMPRESSED_BYTES=1048576
INGEST_MAX_DECOMPRESSED_BYTES=5242880
INGEST_MAX_ITEMS=20
INGEST_MAX_ITEM_BYTES=1048576
MINIDUMP_MAX_BYTES=20971520
CORS_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=info
